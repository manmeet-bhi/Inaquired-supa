{
  "entities": {
    "Job": {
      "title": "Job",
      "description": "A job opportunity listing on inaquired",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 150 },
        "slug": { "type": "string", "minLength": 2, "maxLength": 180 },
        "companyName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "location": { "type": "string", "minLength": 2, "maxLength": 120 },
        "jobType": { "type": "string", "enum": ["full-time", "part-time", "contract", "internship"] },
        "workArrangement": { "type": "string", "enum": ["remote", "on-site", "hybrid"] },
        "category": { "type": "string", "minLength": 2, "maxLength": 60 },
        "experienceLevel": { "type": "string", "enum": ["entry", "mid", "senior", "lead", "internship"] },
        "salaryMin": { "type": "number" },
        "salaryMax": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "description": { "type": "string", "maxLength": 15000 },
        "responsibilities": { "type": "string", "maxLength": 5000 },
        "requirements": { "type": "string", "maxLength": 5000 },
        "benefits": { "type": "string", "maxLength": 5000 },
        "applicationUrl": { "type": "string", "maxLength": 500 },
        "applicationDeadline": { "type": "string", "maxLength": 50 },
        "tags": { "type": "array" },
        "status": { "type": "string", "enum": ["published", "draft", "archived"] },
        "featured": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "publishedAt": { "type": "string" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "seoTitle": { "type": "string", "maxLength": 160 },
        "seoDescription": { "type": "string", "maxLength": 300 }
      },
      "required": ["title", "slug", "companyName", "location", "jobType", "workArrangement", "category", "description", "status"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Administrator account metadata",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["superadmin", "admin"] },
        "mfaEnabled": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "Subscriber": {
      "title": "Subscriber",
      "description": "Push notification subscriber device record",
      "type": "object",
      "properties": {
        "endpoint": { "type": "string", "maxLength": 500 },
        "subscribedAt": { "type": "string" },
        "categories": { "type": "array" }
      },
      "required": ["endpoint", "subscribedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Administrative actions audit log",
      "type": "object",
      "properties": {
        "adminId": { "type": "string", "maxLength": 128 },
        "adminEmail": { "type": "string", "maxLength": 120 },
        "action": { "type": "string", "maxLength": 100 },
        "targetResource": { "type": "string", "maxLength": 100 },
        "details": { "type": "string", "maxLength": 1000 },
        "timestamp": { "type": "string" }
      },
      "required": ["adminId", "action", "timestamp"]
    }
  },
  "firestore": {
    "/jobs/{jobId}": {
      "schema": "Job",
      "description": "All job postings. Public visitors can list and view published jobs. Admins can create, edit, and delete."
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Authorized administrators list used by security rules to check privileges."
    },
    "/subscribers/{subscriberId}": {
      "schema": "Subscriber",
      "description": "Anonymous subscriber tokens for new-job alert notifications."
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Admin activity audit trails, writable and readable only by admins."
    }
  }
}
