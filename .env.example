# Supabase Configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"
# Server-only key required for protected recovery and 2FA RPCs. Never expose with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_DIRECT_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# Supabase Storage Egress (S3 / Storage Endpoint)
VITE_SUPABASE_STORAGE_URL="https://your-project.storage.supabase.co/storage/v1/s3"
VITE_SUPABASE_STORAGE_REGION="ap-northeast-1"
VITE_SUPABASE_STORAGE_BUCKET="ap-northeast-1"

# Resend Email Configuration (Account Recovery & Forgot Password)
# Obtain an API key from https://resend.com/api-keys
RESEND_API_KEY="your_resend_api_key_here"
# Default testing sender is 'onboarding@resend.dev'. For production with verified domain, e.g.: 'inaquired <security@noreply.anywhereroles.in>'
RESEND_FROM_EMAIL="inaquired <security@noreply.anywhereroles.in>"
# Base URL of the application for password reset links
APP_URL="http://localhost:3000"
